# Copy to .env and fill in. Used by both Terraform (TF_VAR_*) and the Taskfile.
# Control Plane names/labels (env/team/region) are NOT set here - they're
# defined directly in terraform/variables.tf's control_planes map, since
# this repo creates 3 Control Planes per apply, each with its own values.
# Edit that map directly to change CP names or add/remove CPs.
KONNECT_PAT=kpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KONNECT_SERVER_URL=https://eu.api.konghq.com

# Must be a Kong Gateway Enterprise image - Konnect rejects OSS data plane
# nodes as COMPATIBILITY_STATE_INCOMPATIBLE and never syncs config.
DP_IMAGE=kong/kong-gateway:3.15.0.5

# Datadog — from your Datadog org: Organization Settings > API Keys.
# Required for the Agent to ingest data (task datadog:up). Plain 32-char
# hex, no prefix - NOT an Application Key (those are prefixed ddapp_/ddpub_
# and won't work here; the Agent will report "API Key" errors if you use one).
DD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Datadog — from your Datadog org: Organization Settings > Application Keys.
# Only needed for task datadog:dashboard (importing the dashboard via API) -
# not required for task up / datadog:up.
DD_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# datadoghq.com (US1) | datadoghq.eu (EU) | us3.datadoghq.com | us5.datadoghq.com | ap1.datadoghq.com
DD_SITE=datadoghq.eu

# Mirrored into TF_VAR_* so terraform picks these up automatically
TF_VAR_konnect_pat=${KONNECT_PAT}
TF_VAR_konnect_server_url=${KONNECT_SERVER_URL}
